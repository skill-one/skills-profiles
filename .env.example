# Optional overrides. Copy this file to `.env` and uncomment what you need.

# SKILLS_PROFILES_MODEL=gpt-4.1-mini
# SKILLS_PROFILES_BASE_URL=https://api.example.com/v1
# SKILLS_PROFILES_API_KEY=sk-...
# SKILLS_PROFILES_LIMIT=50
# How many skills the whole pipeline serves (most installed first) — a ceiling on
# the dataset, not on one run: `run` stops at the top N. 0 = all.
# SKILLS_PROFILES_TOTAL_LIMIT=1000
# SKILLS_PROFILES_CONCURRENCY=8
# SKILLS_PROFILES_LLM_RATE_LIMIT=20  # LLM request starts per minute, shared by the run; 0 = unbounded
# SKILLS_PROFILES_MAX_RETRIES=3  # extra attempts per LLM call and per image request; 0 = a single try
# SKILLS_PROFILES_OUTPUT_DIR=output
# SKILLS_PROFILES_DATA_DIR=cache/skills-sh
# SKILLS_PROFILES_PROMPTS_DIR=prompts

# Covers (`run` renders them after its text pass): a text-to-image endpoint of
# its own, since the chat provider and the image provider are usually different
# services.
# SKILLS_PROFILES_IMAGE_API_KEY=sk-...
# SKILLS_PROFILES_IMAGE_API_KEYS=sk-...,sk-...  # extra keys; each gets its own per-minute quota
# SKILLS_PROFILES_IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
# SKILLS_PROFILES_IMAGE_MODEL=agnes-image-2.5-flash
# SKILLS_PROFILES_IMAGE_SIZE=1024x1024  # exact size; the endpoint also takes 1K/2K/3K/4K tiers
# SKILLS_PROFILES_IMAGE_RATE_LIMIT=20  # max images per minute per key; 0 = unbounded
